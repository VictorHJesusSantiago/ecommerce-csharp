@{ ViewData["Title"] = "Order Invoice"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container mt-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between">
            <h4>Invoice</h4>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print"></i> Print</button>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>ECommerce Store</h5>
                    <p class="text-muted">123 Commerce St<br />New York, NY 10001<br />support@ecommerce.com</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h4>INVOICE</h4>
                    <p><strong>Invoice #:</strong> INV-@ViewBag.OrderId</p>
                    <p><strong>Date:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")</p>
                </div>
            </div>
            <hr />
            <div class="row mb-4">
                <div class="col-md-6">
                    <h6>Bill To:</h6>
                    <p class="text-muted">Customer Name<br />123 Main St<br />New York, NY 10001</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h6>Order Details:</h6>
                    <p class="text-muted">Order #@ViewBag.OrderId<br />Payment: Credit Card</p>
                </div>
            </div>
            <table class="table table-bordered">
                <thead><tr><th>Item</th><th>Quantity</th><th>Unit Price</th><th>Total</th></tr></thead>
                <tbody>
                    <tr><td>Product Name</td><td>2</td><td>$29.99</td><td>$59.98</td></tr>
                </tbody>
                <tfoot>
                    <tr><td colspan="3" class="text-end">Subtotal:</td><td>$59.98</td></tr>
                    <tr><td colspan="3" class="text-end">Shipping:</td><td>$5.99</td></tr>
                    <tr><td colspan="3" class="text-end">Tax:</td><td>$4.80</td></tr>
                    <tr><td colspan="3" class="text-end"><strong>Total:</strong></td><td><strong>$70.77</strong></td></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
