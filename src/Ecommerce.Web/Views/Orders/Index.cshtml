@model Ecommerce.Web.Models.OrderHistoryViewModel

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">
    <h2>My Orders</h2>

    @if (Model.Orders.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-@(order.Status == "Delivered" ? "success" : order.Status == "Cancelled" ? "danger" : "warning")">
                                    @order.Status
                                </span>
                            </td>
                            <td>@order.ItemCount items</td>
                            <td>$@order.TotalAmount.ToString("F2")</td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <h3>No orders yet</h3>
            <p class="text-muted">Start shopping to create your first order.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Start Shopping</a>
        </div>
    }
</div>
