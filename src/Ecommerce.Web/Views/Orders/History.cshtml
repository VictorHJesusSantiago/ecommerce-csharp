@model Ecommerce.Web.Models.OrderHistoryViewModel
@{
    ViewData["Title"] = "Order History";
}

<div class="container">
    <h1>Order History</h1>

    @if (Model.Orders?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>@order.Items?.Count items</td>
                            <td>$@order.TotalAmount.ToString("F2")</td>
                            <td>
                                <span class="badge bg-@(order.Status == "Delivered" ? "success" : order.Status == "Cancelled" ? "danger" : order.Status == "Shipped" ? "info" : "warning")">
                                    @order.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-bag fa-3x text-muted mb-3"></i>
            <h4>No orders yet</h4>
            <p>Start shopping to see your orders here.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Browse Products</a>
        </div>
    }
</div>
