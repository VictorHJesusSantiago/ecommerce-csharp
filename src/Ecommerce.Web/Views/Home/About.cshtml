@model dynamic

@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="display-4 mb-4">About Our Store</h1>
            <p class="lead text-muted">We are passionate about delivering quality products and exceptional customer experiences.</p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-4 text-center mb-4">
            <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>
            <h4>Free Shipping</h4>
            <p class="text-muted">Free shipping on orders over $50. Fast and reliable delivery.</p>
        </div>
        <div class="col-md-4 text-center mb-4">
            <i class="fas fa-undo fa-3x text-primary mb-3"></i>
            <h4>Easy Returns</h4>
            <p class="text-muted">30-day hassle-free returns. Not satisfied? Send it back.</p>
        </div>
        <div class="col-md-4 text-center mb-4">
            <i class="fas fa-headset fa-3x text-primary mb-3"></i>
            <h4>24/7 Support</h4>
            <p class="text-muted">Round-the-clock customer support to help you anytime.</p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-lg-8 mx-auto">
            <h2 class="text-center mb-4">Our Story</h2>
            <p>Founded in 2020, we started with a simple mission: to provide high-quality products at affordable prices with exceptional customer service.</p>
            <p>Over the years, we have grown to serve thousands of customers worldwide, always maintaining our commitment to quality and customer satisfaction.</p>
        </div>
    </div>
</div>
