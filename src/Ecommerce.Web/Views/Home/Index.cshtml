@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold">Welcome to Our Store</h1>
                <p class="lead">Discover amazing products at incredible prices.</p>
                <a href="@Url.Action("Index", "Products")" class="btn btn-primary btn-lg">Shop Now</a>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-truck fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Free Shipping</h5>
                    <p class="card-text">On orders over $50</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Secure Payment</h5>
                    <p class="card-text">100% secure checkout</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-undo fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Easy Returns</h5>
                    <p class="card-text">30-day return policy</p>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mt-5 mb-4">Featured Products</h2>
    <div class="row" id="featured-products">
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <img src="/images/placeholder.jpg" class="card-img-top" alt="Product">
                <div class="card-body">
                    <h5 class="card-title">Sample Product</h5>
                    <p class="card-text text-primary fw-bold">$29.99</p>
                    <a href="#" class="btn btn-outline-primary btn-sm">Add to Cart</a>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mt-5 mb-4">Shop by Category</h2>
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card h-100 bg-primary text-white">
                <div class="card-body text-center">
                    <h5>Electronics</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card h-100 bg-success text-white">
                <div class="card-body text-center">
                    <h5>Clothing</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card h-100 bg-info text-white">
                <div class="card-body text-center">
                    <h5>Home & Garden</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card h-100 bg-warning text-white">
                <div class="card-body text-center">
                    <h5>Sports</h5>
                </div>
            </div>
        </div>
    </div>
</div>
