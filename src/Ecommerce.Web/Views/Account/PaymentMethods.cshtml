@model Ecommerce.Web.Models.AccountPaymentMethodsViewModel
@{
    ViewData["Title"] = "Payment Methods";
}

<div class="container">
    <h1>Payment Methods</h1>
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <a asp-action="Index" class="list-group-item list-group-item-action">Dashboard</a>
                <a asp-action="Settings" class="list-group-item list-group-item-action">Profile Settings</a>
                <a asp-action="Addresses" class="list-group-item list-group-item-action">Addresses</a>
                <a asp-action="PaymentMethods" class="list-group-item list-group-item-action active">Payment Methods</a>
                <a asp-action="Wishlist" class="list-group-item list-group-item-action">Wishlist</a>
                <a asp-controller="Orders" asp-action="History" class="list-group-item list-group-item-action">Order History</a>
            </div>
        </div>
        <div class="col-md-9">
            <div class="d-flex justify-content-between mb-3">
                <h5>Saved Payment Methods</h5>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPaymentModal">Add New Card</button>
            </div>
            @if (Model.PaymentMethods?.Any() == true)
            {
                @foreach (var pm in Model.PaymentMethods)
                {
                    <div class="card mb-3 @(pm.IsDefault ? "border-primary" : "")">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fab fa-cc-@(pm.CardType?.ToLower()) fa-2x me-3"></i>
                                <strong>@pm.CardType</strong> ending in @pm.Last4Digits<br />
                                <small class="text-muted">Expires @pm.ExpiryMonth/@pm.ExpiryYear | @pm.CardHolderName</small>
                                @if (pm.IsDefault) { <span class="badge bg-primary ms-2">Default</span> }
                            </div>
                            <div>
                                <a asp-action="DeletePaymentMethod" asp-route-id="@pm.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5"><p class="text-muted">No payment methods saved yet.</p></div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="addPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddPaymentMethod" method="post">
                <div class="modal-header"><h5>Add New Card</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Card Number</label><input type="text" class="form-control" name="CardNumber" placeholder="1234 5678 9012 3456" required /></div>
                    <div class="row"><div class="col-md-6 mb-3"><label class="form-label">Expiry Month</label><input type="number" class="form-control" name="ExpiryMonth" min="1" max="12" required /></div><div class="col-md-6 mb-3"><label class="form-label">Expiry Year</label><input type="number" class="form-control" name="ExpiryYear" min="2024" required /></div></div>
                    <div class="mb-3"><label class="form-label">Name on Card</label><input type="text" class="form-control" name="CardHolderName" required /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Card</button></div>
            </form>
        </div>
    </div>
</div>
