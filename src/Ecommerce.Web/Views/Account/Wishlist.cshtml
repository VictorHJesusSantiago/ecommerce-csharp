@{
    ViewData["Title"] = "My Wishlist";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>My Wishlist <span class="badge bg-primary">@(ViewBag.ItemCount ?? 0)</span></h1>
    <div class="row" id="wishlist-items">
        <div class="col-12">
            <p class="text-muted">Your wishlist is empty. <a asp-controller="Products" asp-action="Index">Browse products</a></p>
        </div>
    </div>
</div>
