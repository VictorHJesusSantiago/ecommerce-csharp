@{ ViewData["Title"] = "Activity Log"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header"><h4>Activity Log</h4></div>
                <div class="card-body">
                    <div class="list-group">
                        <div class="list-group-item"><div class="d-flex w-100 justify-content-between"><h6 class="mb-1">Login</h6><small class="text-muted">Today, 10:30 AM</small></div><p class="mb-1 text-muted">Successful login from 192.168.1.1</p></div>
                        <div class="list-group-item"><div class="d-flex w-100 justify-content-between"><h6 class="mb-1">Order Placed</h6><small class="text-muted">Yesterday, 3:45 PM</small></div><p class="mb-1 text-muted">Order #ORD-001 placed for $99.99</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
