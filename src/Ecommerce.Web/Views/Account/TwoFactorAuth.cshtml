@{ ViewData["Title"] = "Two-Factor Authentication"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><h4>Two-Factor Authentication</h4></div>
                <div class="card-body">
                    <p>Two-factor authentication adds an extra layer of security to your account.</p>
                    <form asp-action="ToggleTwoFactor" method="post">
                        <div class="form-check form-switch mb-3">
                            <input type="checkbox" class="form-check-input" name="Enabled" value="true" />
                            <label class="form-check-label">Enable Two-Factor Authentication</label>
                        </div>
                        <button type="submit" class="btn btn-primary">Update</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
