@{
    ViewData["Title"] = "Admin - Inventory";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Inventory Management</h1>
        <div>
            <a asp-action="Warehouses" class="btn btn-outline-primary me-2">Warehouses</a>
            <a asp-action="Suppliers" class="btn btn-outline-primary me-2">Suppliers</a>
            <a asp-action="StockMovements" class="btn btn-outline-primary">Stock Movements</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-success text-white"><div class="card-body text-center"><h3>@ViewBag.InStockCount</h3><p>In Stock</p></div></div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white"><div class="card-body text-center"><h3>@ViewBag.LowStockCount</h3><p>Low Stock</p></div></div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white"><div class="card-body text-center"><h3>@ViewBag.OutOfStockCount</h3><p>Out of Stock</p></div></div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white"><div class="card-body text-center"><h3>@ViewBag.TotalProducts</h3><p>Total Products</p></div></div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Low Stock Alerts</h5></div>
        <div class="card-body">
            <table class="table table-sm">
                <thead><tr><th>Product</th><th>SKU</th><th>Current Stock</th><th>Reorder Point</th><th>Action</th></tr></thead>
                <tbody>
                    @if (ViewBag.LowStockProducts != null)
                    {
                        @foreach (dynamic product in ViewBag.LowStockProducts)
                        {
                            <tr>
                                <td>@product.ProductName</td>
                                <td>@product.Sku</td>
                                <td class="text-danger"><strong>@product.CurrentStock</strong></td>
                                <td>@product.ReorderPoint</td>
                                <td><a asp-action="AdjustStock" asp-route-productId="@product.ProductId" class="btn btn-sm btn-outline-primary">Adjust</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
