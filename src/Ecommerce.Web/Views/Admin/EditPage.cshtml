@{
    ViewData["Title"] = "Admin - Edit Page";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h1 class="mb-4">Edit CMS Page</h1>
    <div class="card">
        <div class="card-body">
            <form asp-action="EditPagePost" method="post">
                <input type="hidden" name="Id" value="@ViewBag.PageId" />
                <div class="row">
                    <div class="col-md-8 mb-3"><label class="form-label">Title</label><input type="text" class="form-control" name="Title" value="@ViewBag.Title" required /></div>
                    <div class="col-md-4 mb-3"><label class="form-label">Slug</label><input type="text" class="form-control" name="Slug" value="@ViewBag.Slug" /></div>
                    <div class="col-md-12 mb-3"><label class="form-label">Content</label><textarea class="form-control" name="Content" rows="12">@ViewBag.Content</textarea></div>
                    <div class="col-md-6 mb-3"><label class="form-label">Meta Title</label><input type="text" class="form-control" name="MetaTitle" value="@ViewBag.MetaTitle" /></div>
                    <div class="col-md-6 mb-3"><label class="form-label">Meta Description</label><input type="text" class="form-control" name="MetaDescription" value="@ViewBag.MetaDescription" /></div>
                    <div class="col-md-6 form-check mt-4"><input type="checkbox" class="form-check-input" name="IsPublished" value="true" @(ViewBag.IsPublished == true ? "checked" : "") /><label class="form-check-label">Published</label></div>
                </div>
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Pages" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
