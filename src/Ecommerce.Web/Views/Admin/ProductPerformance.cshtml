@{
    ViewData["Title"] = "Admin - Product Performance";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h1 class="mb-4">Product Performance</h1>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead><tr><th>Product</th><th>SKU</th><th>Revenue</th><th>Qty Sold</th><th>Rating</th><th>Conversion</th><th>Margin</th></tr></thead>
                    <tbody>
                        @if (ViewBag.Products != null)
                        {
                            @foreach (dynamic p in ViewBag.Products)
                            {
                                <tr><td>@p.ProductName</td><td>@p.Sku</td><td>$@p.TotalRevenue</td><td>@p.TotalQuantitySold</td><td>@p.AverageRating</td><td>@p.ConversionRate%</td><td>@p.ProfitMargin%</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
