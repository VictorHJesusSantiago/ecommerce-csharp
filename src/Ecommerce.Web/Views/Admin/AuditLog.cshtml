@{
    ViewData["Title"] = "Admin - Audit Log";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h1 class="mb-4">Inventory Audit Log</h1>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Date</th><th>Product</th><th>Warehouse</th><th>Expected</th><th>Actual</th><th>Variance</th><th>Performed By</th></tr></thead>
                    <tbody>
                        @if (ViewBag.Audits != null)
                        {
                            @foreach (dynamic audit in ViewBag.Audits)
                            {
                                <tr class="@(audit.IsVariance ? "table-warning" : "")">
                                    <td>@audit.PerformedAt</td>
                                    <td>@audit.ProductName</td>
                                    <td>@audit.WarehouseName</td>
                                    <td>@audit.ExpectedQuantity</td>
                                    <td>@audit.ActualQuantity</td>
                                    <td class="@(audit.Variance < 0 ? "text-danger" : audit.Variance > 0 ? "text-success" : "")">@audit.Variance</td>
                                    <td>@audit.PerformedBy</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
