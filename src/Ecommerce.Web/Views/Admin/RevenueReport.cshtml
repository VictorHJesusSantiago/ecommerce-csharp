@{
    ViewData["Title"] = "Admin - Revenue Report";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Revenue Report</h1>
        <div>
            <a asp-action="Reports" class="btn btn-outline-secondary">Back to Reports</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3"><div class="card bg-primary text-white"><div class="card-body text-center"><h3>$@ViewBag.TotalRevenue</h3><p>Total Revenue</p></div></div></div>
        <div class="col-md-3"><div class="card bg-success text-white"><div class="card-body text-center"><h3>$@ViewBag.GrossProfit</h3><p>Gross Profit</p></div></div></div>
        <div class="col-md-3"><div class="card bg-info text-white"><div class="card-body text-center"><h3>@ViewBag.GrossMargin%</h3><p>Gross Margin</p></div></div></div>
        <div class="col-md-3"><div class="card bg-warning text-white"><div class="card-body text-center"><h3>$@ViewBag.AverageOrderValue</h3><p>Avg Order Value</p></div></div></div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Daily Revenue</h5></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Date</th><th>Revenue</th><th>Cost</th><th>Profit</th><th>Orders</th></tr></thead>
                    <tbody>
                        @if (ViewBag.DailyRevenue != null)
                        {
                            @foreach (dynamic day in ViewBag.DailyRevenue)
                            {
                                <tr>
                                    <td>@day.Date</td>
                                    <td>$@day.Revenue</td>
                                    <td>$@day.Cost</td>
                                    <td>$@day.Profit</td>
                                    <td>@day.OrderCount</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
