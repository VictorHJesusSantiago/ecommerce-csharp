@{
    ViewData["Title"] = "Admin - Customer Detail";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Customer Details</h1>
        <a asp-action="Customers" class="btn btn-outline-secondary">Back to Customers</a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body text-center">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;font-size:2rem;">@ViewBag.FirstName?[0]</div>
                    <h5>@ViewBag.FirstName @ViewBag.LastName</h5>
                    <p class="text-muted">@ViewBag.Email</p>
                    <p><span class="badge bg-success">Active</span></p>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-header"><h5>Stats</h5></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2"><span>Total Orders:</span><strong>@ViewBag.TotalOrders</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span>Total Spent:</span><strong>$@ViewBag.TotalSpent</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span>Registered:</span><span>@ViewBag.CreatedAt</span></div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header"><h5>Order History</h5></div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead><tr><th>Order #</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
                        <tbody>
                            @if (ViewBag.CustomerOrders != null)
                            {
                                @foreach (dynamic order in ViewBag.CustomerOrders)
                                {
                                    <tr>
                                        <td>@order.OrderNumber</td>
                                        <td>@order.CreatedAt</td>
                                        <td>$@order.TotalAmount</td>
                                        <td><span class="badge bg-secondary">@order.Status</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
