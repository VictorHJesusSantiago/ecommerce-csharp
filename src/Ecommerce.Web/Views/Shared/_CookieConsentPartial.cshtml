<div class="cookie-consent-bar" id="cookieConsent" style="display:none;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8"><p class="mb-0">We use cookies to enhance your experience. By continuing to visit this site you agree to our use of cookies. <a asp-controller="Home" asp-action="CookiesPolicy">Learn more</a></p></div>
            <div class="col-md-4 text-md-end">
                <button class="btn btn-primary btn-sm me-2" onclick="acceptCookies()">Accept</button>
                <button class="btn btn-outline-secondary btn-sm" onclick="declineCookies()">Decline</button>
            </div>
        </div>
    </div>
</div>
