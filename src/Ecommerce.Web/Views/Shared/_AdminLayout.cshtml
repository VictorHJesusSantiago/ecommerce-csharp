@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <div class="d-flex" id="admin-wrapper">
        <nav class="admin-sidebar bg-dark text-light" style="width:250px;min-height:100vh;">
            <div class="p-3"><h4 class="text-light">Admin</h4></div>
            <ul class="nav flex-column px-2">
                <li class="nav-item"><a class="nav-link text-light" asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="Admin" asp-action="Products"><i class="fas fa-box me-2"></i>Products</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="Admin" asp-action="Orders"><i class="fas fa-shopping-cart me-2"></i>Orders</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="Admin" asp-action="Customers"><i class="fas fa-users me-2"></i>Customers</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="AdminInventory" asp-action="Index"><i class="fas fa-warehouse me-2"></i>Inventory</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="AdminMarketing" asp-action="Index"><i class="fas fa-bullhorn me-2"></i>Marketing</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="AdminReports" asp-action="Revenue"><i class="fas fa-chart-bar me-2"></i>Reports</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="AdminNotification" asp-action="Index"><i class="fas fa-bell me-2"></i>Notifications</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="AdminCatalog" asp-action="Categories"><i class="fas fa-tags me-2"></i>Categories</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="AdminCatalog" asp-action="Brands"><i class="fas fa-star me-2"></i>Brands</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="AdminCatalog" asp-action="Pages"><i class="fas fa-file me-2"></i>CMS Pages</a></li>
                <li class="nav-item"><a class="nav-link text-light" asp-controller="Admin" asp-action="Settings"><i class="fas fa-cog me-2"></i>Settings</a></li>
            </ul>
        </nav>
        <main class="flex-grow-1 p-4">@RenderBody()</main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
