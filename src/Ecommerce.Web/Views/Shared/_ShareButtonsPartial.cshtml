<div class="share-buttons mt-3">
    <h6>Share this product</h6>
    <div class="d-flex gap-2">
        <a href="https://www.facebook.com/sharer/sharer.php?u=@ViewData["ShareUrl"]" target="_blank" class="btn btn-outline-primary btn-sm"><i class="fab fa-facebook-f"></i> Facebook</a>
        <a href="https://twitter.com/intent/tweet?url=@ViewData["ShareUrl"]&text=@ViewData["ShareTitle"]" target="_blank" class="btn btn-outline-info btn-sm"><i class="fab fa-twitter"></i> Twitter</a>
        <a href="https://pinterest.com/pin/create/button/?url=@ViewData["ShareUrl"]" target="_blank" class="btn btn-outline-danger btn-sm"><i class="fab fa-pinterest"></i> Pinterest</a>
        <a href="mailto:?subject=@ViewData["ShareTitle"]&body=Check%20this%20out:%20@ViewData["ShareUrl"]" class="btn btn-outline-secondary btn-sm"><i class="fas fa-envelope"></i> Email</a>
    </div>
</div>
