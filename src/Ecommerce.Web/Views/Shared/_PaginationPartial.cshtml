@model dynamic
<div class="pagination justify-content-center">
    <ul class="pagination">
        @{
            int currentPage = Model?.CurrentPage ?? 1;
            int totalPages = Model?.TotalPages ?? 1;
            string action = Model?.Action ?? "Index";
            string controller = Model?.Controller ?? "Home";
        }
        @if (currentPage > 1)
        {
            <li class="page-item"><a class="page-link" asp-action="@action" asp-controller="@controller" asp-route-page="@(currentPage - 1)">Previous</a></li>
        }
        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" asp-action="@action" asp-controller="@controller" asp-route-page="@i">@i</a>
            </li>
        }
        @if (currentPage < totalPages)
        {
            <li class="page-item"><a class="page-link" asp-action="@action" asp-controller="@controller" asp-route-page="@(currentPage + 1)">Next</a></li>
        }
    </ul>
</div>
