@{ ViewData["Title"] = "Advanced Search"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container mt-4">
    <h1>Advanced Search</h1>
    <div class="card">
        <div class="card-body">
            <form asp-action="Index" asp-controller="Search" method="get">
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">Keywords</label><input type="text" class="form-control" name="q" placeholder="Search for products..." /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Category</label><select class="form-select" name="category"><option value="">All Categories</option></select></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Brand</label><select class="form-select" name="brand"><option value="">All Brands</option></select></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Min Price</label><input type="number" class="form-control" name="minPrice" step="0.01" min="0" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Max Price</label><input type="number" class="form-control" name="maxPrice" step="0.01" min="0" /></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Min Rating</label><select class="form-select" name="minRating"><option value="">Any</option><option value="4">4+ Stars</option><option value="3">3+ Stars</option><option value="2">2+ Stars</option><option value="1">1+ Stars</option></select></div>
                    <div class="col-md-3 mb-3"><label class="form-label">Sort By</label><select class="form-select" name="sort"><option value="relevance">Relevance</option><option value="price_asc">Price: Low to High</option><option value="price_desc">Price: High to Low</option><option value="newest">Newest</option><option value="rating">Rating</option><option value="popular">Popularity</option></select></div>
                    <div class="col-md-3 mb-3 d-flex align-items-end">
                        <div class="form-check me-3"><input type="checkbox" class="form-check-input" name="inStock" value="true" /><label class="form-check-label">In Stock Only</label></div>
                        <div class="form-check"><input type="checkbox" class="form-check-input" name="onSale" value="true" /><label class="form-check-label">On Sale</label></div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary ms-2">Reset</a>
            </form>
        </div>
    </div>
</div>
