<environment include="Development">
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Server=localhost;Database=ECommerceDev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True" providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Jwt:SecretKey" value="super-secret-key-for-development-32chars!" />
    <add key="Jwt:Issuer" value="ECommerceDev" />
    <add key="Jwt:Audience" value="ECommerceDevUsers" />
    <add key="Redis:ConnectionString" value="localhost:6379" />
    <add key="RabbitMQ:HostName" value="localhost" />
  </appSettings>
</environment>
